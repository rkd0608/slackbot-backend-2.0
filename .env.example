# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret
OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Create these Price IDs in your Stripe Dashboard -> Products
STRIPE_PRICE_STARTER=price_starter_id
STRIPE_PRICE_GROWTH=price_growth_id
STRIPE_PRICE_BUSINESS=price_business_id
STRIPE_PRICE_ENTERPRISE=price_enterprise_id

# Email Configuration (AWS SES)
# Verify this email address in AWS SES first
EMAIL_SENDER_ADDRESS=noreply@your-domain.com
EMAIL_SENDER_NAME=Slack AI Assistant

# MySQL Configuration
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=slackbot
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=slack_intelligence

# Pinecone Configuration
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=slack-embeddings
PINECONE_GITHUB_INDEX_NAME=github-code-embeddings

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=slack-intelligence-files

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password
REDIS_DB=0

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_LLM_MODEL=gpt-4-turbo

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WORKERS=4

# Secrets Management (Production)
# Set to true in production to use AWS Secrets Manager instead of .env file
USE_SECRETS_MANAGER=false
AWS_SECRET_NAME=slackbot/production

# Security
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Performance Settings
MAX_CONTEXT_TOKENS=150000
EMBEDDING_BATCH_SIZE=100
RETRIEVAL_CANDIDATES=200
RERANK_TOP_K=50
CACHE_TTL_SECONDS=300

# File Upload Security
MAX_FILE_SIZE_MB=50

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/github/callback

# GitHub API
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28

# Integration Settings
# Token encryption (32-byte key for AES-256)
OAUTH_TOKEN_ENCRYPTION_KEY=your-32-byte-encryption-key-change-in-production

# Code Embedding Settings
ENABLE_DUAL_EMBEDDING=true
CODE_EMBEDDING_WEIGHT=0.6
SEMANTIC_EMBEDDING_WEIGHT=0.4

# Chunking Settings
MAX_FILE_SIZE_FOR_CHUNKING=10000
MAX_LINES_FOR_CHUNKING=500

# Code Intelligence
ENABLE_CODE_INTELLIGENCE=true
CACHE_CODE_STRUCTURE=true
CODE_STRUCTURE_CACHE_TTL=86400

# Integration Settings - Token Encryption
# Generate a new 32-byte encryption key using:
# python3 -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode('utf-8'))"
OAUTH_TOKEN_ENCRYPTION_KEY=generate-your-own-32-byte-key-here
